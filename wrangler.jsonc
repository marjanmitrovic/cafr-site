{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ucfr-site",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/uploads",
      "/uploads/*"
    ]
  },
  "vars": {
    "UCFR_BACKEND_ORIGIN": "https://cafr-site.onrender.com",
    "UCFR_UPTIME_MONITOR_ENABLED": "true"
  },
  "triggers": {
    // The handler only probes from 10:00 to 21:00 Europe/Prague.
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
