{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ucfr-site",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/uploads",
      "/uploads/*"
    ]
  },
  "vars": {
    "UCFR_BACKEND_ORIGIN": "https://cafr-site.onrender.com",
    "UCFR_UPTIME_MONITOR_ENABLED": "false"
  },
  "triggers": {
    // Enable */10 * * * * only after checking the shared Render hour balance.
    "crons": []
  },
  "observability": {
    "enabled": true
  }
}
