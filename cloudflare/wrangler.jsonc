{
  "name": "ucfr-site-next",
  "main": "worker.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "define": { "process.env.NODE_ENV": "\"production\"" },
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/preview", "/api", "/api/*", "/uploads", "/uploads/*"]
  },
  "observability": { "enabled": true },
  "triggers": { "crons": [] }
}
